{
  "$schema": "https://qoder.com/schemas/settings.json",
  "version": "1.0.0",
  "_comment": "EXPERIMENTAL: This settings.json format is not officially documented by Qoder. It may not work as expected. Official configuration is done via Qoder IDE UI (⌘⇧, or Ctrl+Shift+,). See: https://docs.qoder.com/plugins/settings",
  "memory": {
    "_note": "Qoder has 2 memory types: Active (user-specified) and Automatic (learned). Custom categories below are experimental.",
    "enabled": true,
    "categories": {
      "active_memory": {
        "enabled": true,
        "description": "User-specified memories (via Agent mode)",
        "sources": []
      },
      "automatic_memory": {
        "enabled": true,
        "description": "Auto-learned from conversations, coding style, and project patterns",
        "sources": [".qoder/rules/project-info.md"]
      }
    }
  },
  "rules": {
    "_note": "Rules are configured in Qoder IDE by right-clicking .md files. Settings below are experimental.",
    "directory": ".qoder/rules",
    "suggestions": {
      "always_apply": ["requirements-spec.md"],
      "model_decision": ["security.md", "testing.md", "api-design.md"],
      "apply_manually": ["*"]
    }
  },
  "quest": {
    "_note": "Quest Mode settings are configured in Qoder IDE. Values below are suggestions only.",
    "enabled": true,
    "recommendations": {
      "enforceCompleteCode": "Enable via requirements-spec.md rule (Always Apply)",
      "requireTests": {{#if detection.testing}}true{{else}}false{{/if}},
      "characterLimit": "100,000 characters across all active rules - monitor in Settings"
    }
  },
  "project": {
    "name": "{{project.name}}",
    "language": "{{project.language}}",
    "type": "{{project.type}}"{{#if project.framework}},
    "framework": "{{project.framework}}"{{/if}}
  },
  "generated": {
    "by": "Brief CLI v{{generated.version}}",
    "date": "{{generated.date}}",
    "disclaimer": "This file is generated for reference. Qoder settings are primarily configured via IDE UI."
  }
}
